# Placeholders only. Generate a private .env following README.md before starting.
POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace_with_generated_password
POSTGRES_DB=replace_with_local_database
DATABASE_URL=postgresql+psycopg://replace_with_local_user:replace_with_url_encoded_password@127.0.0.1:5434/replace_with_local_database
# Required. Generate privately with secrets.token_urlsafe(48); never commit/log.
AUTH_JWT_SECRET=
APP_ENV=development
# JSON array of explicit local frontend origins; these are also the defaults.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8000"]
