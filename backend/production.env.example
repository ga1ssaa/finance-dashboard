# Documentation only; production reads process variables, never private .env files.
# Replace all placeholders in Heroku config; never commit real values.
APP_ENV=production
AUTH_JWT_SECRET=
DATABASE_URL=
PRODUCTION_SITE_DOMAIN=getavero.app
PRODUCTION_API_ORIGIN=https://api.getavero.app
CORS_ALLOWED_ORIGINS=["https://getavero.app"]
TRUSTED_PROXY=heroku
PRODUCTION_DATABASE_HOST=replace-with-provider-host.amazonaws.com
PRODUCTION_DATABASE_NAME=replace_with_new_provider_database
DATABASE_SSLROOTCERT=/usr/lib/ssl/certs/ca-certificates.crt
# DYNO and PORT come from Heroku. Do not set them manually.
